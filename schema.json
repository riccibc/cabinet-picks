{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riccibc/cabinet-picks/schema.json",
  "title": "Cabinet weekly picks",
  "description": "Hand-chosen records shown in the Crate tab. Each week goes live on its goLive date (Pacific time) and stays up until the next week's date passes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["weeks"],
  "properties": {
    "weeks": {
      "type": "array",
      "items": { "$ref": "#/$defs/week" }
    }
  },
  "$defs": {
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goLive", "title", "picks"],
      "properties": {
        "goLive": {
          "description": "The day this list goes live, Pacific time. Usually a Friday.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "description": "Shown as the heading, followed by the date: \"Picks · Nov 20\".",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "picks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/pick" }
        }
      }
    },
    "pick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mbid", "artist", "title", "year", "note"],
      "properties": {
        "mbid": {
          "description": "MusicBrainz release-group ID. Cover art comes from the Cover Art Archive by this ID.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "artist": { "type": "string", "minLength": 1, "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "note": {
          "description": "One or two lines, in your words. Must be written before pushing.",
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "tag": {
          "type": "string",
          "enum": ["new", "reissue", "new pressing"]
        }
      }
    }
  }
}
